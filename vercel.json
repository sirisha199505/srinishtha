{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://srinishtha-api.onrender.com/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://srinishtha-api.onrender.com/uploads/:path*" },
    { "source": "/sitemap.xml", "destination": "https://srinishtha-api.onrender.com/sitemap.xml" },
    { "source": "/robots.txt", "destination": "https://srinishtha-api.onrender.com/robots.txt" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
